// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
  id                Int                @id(map: "User_pkey") @default(autoincrement())
  email             String
  nickname          String
  image             String?
  encryptedPassword String
  createdAt         TimestampString(3) @default(now())
  updatedAt         temporal.timestampString(3, onCreate: now, onUpdate: now)
  articles          Article[]
  comments          Comment[]
  likes             Like[]
  products          Product[]
  socialAccounts    SocialAccount[]

  @@index([email], map: "User_email_key", unique: true)
  @@index([nickname], map: "User_nickname_key", unique: true)
}

model SocialAccount {
  id         Int                @id(map: "SocialAccount_pkey") @default(autoincrement())
  provider   String
  providerId String
  createdAt  TimestampString(3) @default(now())
  updatedAt  temporal.timestampString(3, onCreate: now, onUpdate: now)
  userId     Int
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SocialAccount_userId_fkey", index: false)

  @@index([provider, providerId], map: "SocialAccount_provider_providerId_key", unique: true)
  @@index([userId], map: "SocialAccount_userId_idx")
}

model Article {
  id         Int                @id(map: "Article_pkey") @default(autoincrement())
  title      String
  content    String
  createdAt  TimestampString(3) @default(now())
  updatedAt  temporal.timestampString(3, onCreate: now, onUpdate: now)
  likeCount  Int                @default(0)
  author     String?
  images     String[]           @default([]) @noCheck(elementNotNull)
  authorId   Int?
  comments   Comment[]
  likes      Like[]
  authorUser User?              @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Article_authorId_fkey", index: false)
}

model Product {
  id            Int                @id(map: "Product_pkey") @default(autoincrement())
  name          String
  description   String
  price         Int
  tags          String[]?          @default([]) @noCheck(elementNotNull)
  createdAt     TimestampString(3) @default(now())
  updatedAt     temporal.timestampString(3, onCreate: now, onUpdate: now)
  favoriteCount Int                @default(0)
  images        String[]?          @default([]) @noCheck(elementNotNull)
  ownerId       Int?
  comments      Comment[]
  likes         Like[]
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Product_ownerId_fkey", index: false)
}

model Comment {
  id        Int                @id(map: "Comment_pkey") @default(autoincrement())
  content   String
  productId Int?
  articleId Int?
  createdAt TimestampString(3) @default(now())
  updatedAt temporal.timestampString(3, onCreate: now, onUpdate: now)
  authorId  Int?
  article   Article?           @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Comment_articleId_fkey", index: false)
  author    User?              @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Comment_authorId_fkey", index: false)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Comment_productId_fkey", index: false)

  @@check(expression: sql`((("productId" IS NOT NULL) AND ("articleId" IS NULL)) OR (("productId" IS NULL) AND ("articleId" IS NOT NULL)))`, map: "chk_Comment_exactly_one_target")
}

model Like {
  id        Int                @id(map: "Like_pkey") @default(autoincrement())
  userId    Int
  productId Int?
  createdAt TimestampString(3) @default(now())
  articleId Int?
  article   Article?           @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Like_articleId_fkey", index: false)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Like_productId_fkey", index: false)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Like_userId_fkey", index: "Like_userId_articleId_key")

  @@index([userId, articleId], map: "Like_userId_articleId_key", unique: true)
  @@index([userId, productId], map: "Like_userId_productId_key", unique: true)
}
