NODE_ENV=development
PORT=5001

# PostgreSQL 연결 주소 (본인 로컬 환경에 맞게 수정)
DATABASE_URL=postgresql://USER@localhost:5432/panda_market

# 로컬/예시용 — 실제 운영에서는 별도 시크릿을 사용해 주세요 (32자 이상)
JWT_SECRET=replace-with-your-own-secret-32-characters-min
# OAuth state 서명용 시크릿 (32자 이상 · JWT_SECRET 과 다른 값 권장)
OAUTH_STATE_SECRET=replace-with-another-secret-32-characters-min

# CORS 허용 오리진(콤마 구분) · 백엔드/프론트 기준 주소
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_BASE_URL=http://localhost:5001
CLIENT_BASE_URL=http://localhost:3000

# 소셜 로그인 (미설정이면 해당 버튼이 400 안내를 보여 줍니다)
# 리다이렉트 URI 는 {API_BASE_URL}/api/auth/social/callback/{provider} 로 자동 조합됩니다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=<REST API 키>
# KAKAO_CLIENT_SECRET=<클라이언트 시크릿 — 카카오는 기본 활성화 상태>
